# =============================================================================
# Smart Mine — environment template
# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored — NEVER commit real keys or credentials here.
# =============================================================================

# ---------------- Firebase (off-chain data layer) ----------------
# Firebase Console -> Project settings -> General -> Your apps (web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---------------- App behaviour ----------------
# Hours before an incident auto-escalates
VITE_DEFAULT_ESCALATION_HOURS=24

# ---------------- Blockchain trust layer ----------------
# RPC endpoint of the deployed network (e.g. Hardhat local, Sepolia)
VITE_BLOCKCHAIN_RPC_URL=
# E.g. 31337 (Hardhat local), 11155111 (Sepolia)
VITE_BLOCKCHAIN_CHAIN_ID=
VITE_BLOCKCHAIN_NETWORK_NAME=
# Account address that deployed the contracts
VITE_BLOCKCHAIN_DEPLOYER_ADDRESS=
# Contract addresses from `npx hardhat run scripts/deploy.ts`
VITE_BLOCKCHAIN_MINE_REGISTRY=
VITE_BLOCKCHAIN_ROLE_REGISTRY=
VITE_BLOCKCHAIN_ATTENDANCE_LEDGER=
VITE_BLOCKCHAIN_INSPECTION_LEDGER=
VITE_BLOCKCHAIN_COMPLAINT_LEDGER=
VITE_BLOCKCHAIN_INCIDENT_LEDGER=
VITE_BLOCKCHAIN_DOCUMENT_REGISTRY=
VITE_BLOCKCHAIN_APPROVAL_WORKFLOW=
VITE_BLOCKCHAIN_COMPLIANCE_LEDGER=
VITE_BLOCKCHAIN_AUDIT_TRAIL=
# "true" to require wallet signatures (MetaMask etc.)
VITE_BLOCKCHAIN_WALLET_ENABLED=false

# ---------------- Hardhat / deploy scripts ----------------
# Private key of the deployer account. Local default (Hardhat): 0xac09...ff80
DEPLOYER_PRIVATE_KEY=

# ---------------- Admin/dev helper scripts (_admin_check.mjs) ----------------
# Supabase project URL and service-role secret key (used by _admin_check.mjs)
VITE_SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Test account used by _admin_check.mjs — use your OWN test user, never real credentials
VITE_TEST_EMAIL=
VITE_TEST_PASSWORD=

# ---------------- Legacy: Supabase (optional, older flows / SETUP.md) ----------------
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_REALTIME_ENABLED=false