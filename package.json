{
  "name": "smart-mine",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/blockchain-dev.mjs",
    "dev:vite": "vite",
    "build": "tsc && vite build",
    "lint": "tsc",
    "preview": "vite preview",
    "ml": "python ml_server.py",
    "ml:port": "python ml_server.py",
    "start": "concurrently \"npm run ml\" \"npm run dev\"",
    "chain": "npx hardhat node",
    "blockchain:start": "npx hardhat node",
    "blockchain:deploy": "npx hardhat run scripts/deploy.ts --network localhost",
    "blockchain:deploy:local": "npx hardhat run scripts/deploy.ts --network localhost",
    "blockchain:test": "npx hardhat test test/blockchain.test.ts",
    "blockchain:compile": "npx hardhat compile",
    "mcp": "npx -y @playwright/mcp@latest",
    "docs:pdf": "node scripts/generate_finalarchi.cjs"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "@react-three/drei": "9.99.0",
    "@react-three/fiber": "8.15.19",
    "@types/three": "0.160.0",
    "ethers": "^6.17.0",
    "firebase": "^10.14.1",
    "framer-motion": "^11.0.8",
    "jspdf": "^2.5.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.344.0",
    "papaparse": "^5.4.1",
    "pdfjs-dist": "4.10.38",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "recharts": "^2.12.2",
    "tesseract.js": "^7.0.0",
    "three": "0.160.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/leaflet": "^1.9.8",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.24",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
