    "hardhat": "^2.29.1",
    "hardhat-gas-reporter": "^1.0.10",
    "playwright": "^1.63.0",
    "postcss": "^8.4.35",
    "solidity-coverage": "^0.8.17",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.3.3",
    "vite": "^5.1.4"
